KAIRO_FUNDING_API_KEY=replace_with_your_key
KAIRO_FUNDING_BASE_URL=https://api.kairo.zone

# Example-specific overrides:
KAIRO_EXCHANGE=bybit
KAIRO_BASE=BTC
KAIRO_THRESHOLD=0.001
KAIRO_WATCHLIST=BTC,ETH,SOL
KAIRO_ALERT_MINUTES=10
