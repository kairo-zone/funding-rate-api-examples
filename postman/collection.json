        {
          "name": "GET /v1/funding - delta since cursor",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/funding?since={{version}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "funding"],
              "query": [
                { "key": "since", "value": "{{version}}" }
              ]
            },
            "description": "Delta poll. Returns only rows whose version is strictly greater than `since`. Run the compact snapshot request first so `{{version}}` is populated."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const v = pm.collectionVariables.get(\"version\");",
                  "if (!v) {",
                  "    console.warn(\"version is empty; run the 'full snapshot (compact)' request first to populate the cursor.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has version, count, data\", () => {",
                  "    pm.expect(body).to.have.property(\"version\");",
                  "    pm.expect(body).to.have.property(\"count\");",
                  "    pm.expect(body).to.have.property(\"data\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/funding - conditional GET",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "If-None-Match", "value": "\"{{version}}\"" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/funding",
              "host": ["{{base_url}}"],
              "path": ["v1", "funding"]
            },
            "description": "Conditional GET. Returns 304 Not Modified when the server's ETag still matches `{{version}}`, otherwise returns 200 with a fresh snapshot. Run the compact snapshot request first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 or 304\", () => pm.expect([200, 304]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
