{
  "info": {
    "_postman_id": "a1f9c2e7-4d6b-4a8b-9e1c-1f0f5b7a3d21",
    "name": "kairo.zone Funding API",
    "description": "Live perpetual funding rates from 10 exchanges (Bybit, MEXC, AsterDEX, Hyperliquid, Binance, Gate, Bitget, BingX, OKX, KuCoin) under a single normalized schema.\n\nResponses default to a compact positional shape; pass `compact=false` for named-object rows. Use the monotonically-increasing `version` field with `since` for delta polling, or with `If-None-Match` for conditional GET.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-Api-Key", "type": "string" },
      { "key": "value", "value": "{{api_key}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "{{base_url}}", "type": "string" },
    { "key": "api_key", "value": "{{api_key}}", "type": "string" },
    { "key": "version", "value": "", "type": "string", "description": "Populated by the first snapshot request via a test script. Used as the cursor for delta and conditional GET requests." }
  ],
  "item": [
    {
      "name": "Funding",
      "description": "Funding-rate snapshots and deltas.",
      "item": [
        {
          "name": "GET /v1/funding - full snapshot (compact)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/v1/funding",
              "host": ["{{base_url}}"],
              "path": ["v1", "funding"]
            },
            "description": "Full snapshot in compact (positional) shape. Use as the default polling call. The test script captures `version` for downstream requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has version, count, data\", () => {",
                  "    pm.expect(body).to.have.property(\"version\");",
                  "    pm.expect(body).to.have.property(\"count\");",
                  "    pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "pm.collectionVariables.set(\"version\", body.version);"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK (compact)",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": { "raw": "{{base_url}}/v1/funding", "host": ["{{base_url}}"], "path": ["v1", "funding"] }
              },
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "ETag", "value": "\"1712304000042\"" },
                { "key": "X-Funding-Version", "value": "1712304000042" }
              ],
              "body": "{\n  \"version\": 1712304000042,\n  \"timestamp_ms\": 1712304000123,\n  \"count\": 2,\n  \"data\": [\n    [\"bybit\", \"BTC\", 0.0001, 1712304000000, 8, 1712299900000],\n    [\"binance\", \"ETH\", 0.00012, 1712304000000, 8, 1712299900000]\n  ]\n}"
            }
          ]
        },
